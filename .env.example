ENVIRONMENT=development
APP_NAME=MediCORE
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
DOMAIN=example.com
PRICE_FX_RATES_JSON={"INR":1.0}
MOCK_DATA_ENABLED=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=catalog-pdfs
MAILBOX_FERNET_KEY=generate-a-fernet-key
AI_SETTINGS_FERNET_KEY=generate-a-fernet-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
AI_READONLY_DATABASE_URL=postgresql://medicore_ai_readonly:your-readonly-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_POOLER_HOST=
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_USER=

VALKEY_URL=redis://:your-valkey-password@valkey:6379/0
REDIS_URL=redis://localhost:6379/0

CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-frontend-domain.com
OPENROUTER_APP_NAME=MediCORE

EMAIL_MODE=imap
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-gmail-address@gmail.com
IMAP_PASSWORD=your-gmail-app-password
IMAP_MAILBOX=INBOX

GMAIL_WEBHOOK_TOKEN=generate-a-random-webhook-token
GMAIL_OAUTH_TOKEN=
GMAIL_USER_ID=me
GOOGLE_PROJECT_ID=your-google-cloud-project-id
GOOGLE_PUBSUB_TOPIC=your-gmail-pubsub-topic

# Transactional admin emails use Gmail API.
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-oauth-refresh-token
GMAIL_API_SENDER=your-gmail-address@gmail.com

SUPERADMIN_EMAIL_ID=superadmin@example.com

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/chat
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPERADMIN_EMAIL=superadmin@example.com


